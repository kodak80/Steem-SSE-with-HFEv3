FLOPPYBRIDGE
; A real floppy drive for Steem, through FloppyBridge.
; Insert this file in drive A: or B: like a disk image.
; Needs FloppyBridge_x64.dll (64-bit Steem) or FloppyBridge.dll (32-bit)
; next to Steem: https://amiga.robsmithdev.co.uk/winuae
; Close DiskFlashback, or release the drive from it, before inserting.

driver=greaseweazle   ; greaseweazle, drawbridge or supercardpro
port=auto             ; auto, or the serial port, eg COM5
drive=A               ; A or B (PC cable, try B if nothing is read), 0-3 Shugart
log=on                ; on: what is read goes to Greaseweazle.log, next to this file
density=auto          ; auto: only real density changes (protections); off; raw
cache=off             ; off: drive spins only when the ST reads, like a real ST
                      ; on: reads the whole disk ahead (faster loading, but the
                      ; drive also runs while Steem is stopped)
write=off             ; off: the disk is read-only (write-protected for the ST)
                      ; on: what the ST writes is written to the disk - try it
                      ; on a copy first, see README-FloppyBridge.txt
